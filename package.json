{
  "name": "yang-teacher-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo",
    "build:demo": "tsc -b && VITE_DEMO_MODE=true vite build",
